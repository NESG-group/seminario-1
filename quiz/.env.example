SECRET_KEY=cambia-esto-por-una-cadena-larga-aleatoria
AUTH_MODE=ldap
LDAP_URL=ldaps://ldap.ejemplo.org
# Opcion A: bind directo con plantilla de DN
LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=ejemplo,dc=org
# Opcion B: cuenta de servicio + busqueda (deja la plantilla vacia)
# LDAP_BIND_DN=cn=lector,dc=ejemplo,dc=org
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=ou=people,dc=ejemplo,dc=org
# LDAP_SEARCH_FILTER=(uid={username})
# LDAP_DISPLAY_ATTR=cn
# LDAP_STARTTLS=false
ADMIN_USERS=irene
COOKIE_SECURE=true
SESSION_HOURS=12
# Opcional: sustituye al chat_url de answers.json
# CHAT_URL=https://demo.ejemplo.org
# Opcional: Markdown con las instrucciones, publicado en /instrucciones sin login
# INSTRUCTIONS_FILE=/srv/quiz/docs/instrucciones-seminario-1.md
