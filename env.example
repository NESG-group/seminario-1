# Template for .env. `make env` creates .env from it with a random key and
# your UID/GID. Never commit the real .env file.

# --- Hermes Agent ---
# Shared secret between the hermes service (API_SERVER_KEY) and demo-backend
# (HERMES_API_KEY), used to authenticate FastAPI's calls to Hermes's OpenAI-compatible API.
# Must be at least 16 characters: with a shorter key Hermes silently does not
# start its API server.
HERMES_API_SERVER_KEY=change-me-to-a-strong-random-string

# Host UID/GID that Hermes runs as, so the bind-mounted hermes/ files stay owned
# by you. Set them to the output of `id -u` and `id -g`.
HERMES_UID=1000
HERMES_GID=1000

# --- demo-backend (FastAPI) ---
# Only needed to override the docker-compose defaults, e.g. for local (non-container) runs.
# HERMES_BASE_URL=http://localhost:8642/v1
# DEFAULT_LLM_MODEL=qwen2.5:72b

# --- Multi-user access (docker-compose.multiuser.yml) ---
# `make multiuser-env` appends these to .env with random values and DEMO_HOST
# set to this machine's IP. Not needed for the single-user setup.
# DEMO_HOST=192.0.2.10                 # name or IP users type in the browser
# USER_JWT_SECRET=...                  # Open WebUI signs the user JWT with it; enables multi-user mode
# LLDAP_ADMIN_PASSWORD=...             # admin of the bundled LLDAP (http://127.0.0.1:17170)
# LLDAP_JWT_SECRET=...
# LLDAP_KEY_SEED=...
#
# To use another LDAP server instead of the bundled LLDAP, override these:
# LDAP_SERVER_HOST=ldap.example.org
# LDAP_SERVER_PORT=636
# LDAP_USE_TLS=true
# LDAP_APP_DN=cn=search-account,ou=services,dc=example,dc=org
# LDAP_APP_PASSWORD=...
# LDAP_SEARCH_BASE=ou=people,dc=example,dc=org
# LDAP_ATTRIBUTE_FOR_USERNAME=uid      # sAMAccountName on Active Directory
# LDAP_SEARCH_FILTERS=(memberOf=cn=demo,ou=groups,dc=example,dc=org)
