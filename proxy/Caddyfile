{
	# Clients send no SNI when DEMO_HOST is an IP address: serve its certificate anyway.
	default_sni {$DEMO_HOST}
}

{$DEMO_HOST} {
	# Certificate from Caddy's own CA (internal network, no public domain).
	# Browsers warn until its root certificate is trusted: see README.
	tls internal

	reverse_proxy open-webui:8080 {
		# Pass answers through as they stream instead of buffering them.
		flush_interval -1
	}
}

# Seminar quiz, same host on another port (it shares /api paths with Open WebUI).
{$DEMO_HOST}:{$QUIZ_PORT:9443} {
	tls internal
	reverse_proxy quiz:8080
}
